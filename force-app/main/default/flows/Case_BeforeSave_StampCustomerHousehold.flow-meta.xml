<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <assignments>
        <name>clear_household</name>
        <label>Clear the household</label>
        <locationX>314</locationX>
        <locationY>323</locationY>
        <assignmentItems>
            <assignToReference>$Record.Customer_Household__c</assignToReference>
            <operator>Assign</operator>
        </assignmentItems>
    </assignments>
    <assignments>
        <name>stamp_household</name>
        <label>Stamp the household</label>
        <locationX>50</locationX>
        <locationY>323</locationY>
        <assignmentItems>
            <assignToReference>$Record.Customer_Household__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.AccountId</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <decisions>
        <name>is_billing_dispute</name>
        <label>Is it a billing dispute?</label>
        <locationX>182</locationX>
        <locationY>215</locationY>
        <defaultConnector>
            <targetReference>clear_household</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Any other case</defaultConnectorLabel>
        <rules>
            <name>billing_dispute</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Billing_Dispute</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>stamp_household</targetReference>
            </connector>
            <label>Billing dispute</label>
        </rules>
    </decisions>
    <description>ST-06, ST-12, S-16. Copies the account onto Customer_Household__c for Billing Dispute cases, and clears it on every other case. Runs when a case is created or its record type or account changes, and when a dispute's household doesn't match its account, so any save repairs it. The Customer_Household sharing set reads that field, so customers see their own disputes in the portal, including ones a rep opened, and never a default review.</description>
    <environments>Default</environments>
    <interviewLabel>Case_BeforeSave_StampCustomerHousehold {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Case: Stamp Customer Household</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>56</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>is_billing_dispute</targetReference>
        </connector>
        <filterFormula>ISNEW() || ISCHANGED({!$Record.RecordTypeId}) || ISCHANGED({!$Record.AccountId}) || (NOT(ISBLANK({!$Record.Disputed_Statement__c})) &amp;&amp; {!$Record.Customer_Household__c} &lt;&gt; {!$Record.AccountId})</filterFormula>
        <object>Case</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
