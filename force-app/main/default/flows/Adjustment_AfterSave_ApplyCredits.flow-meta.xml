<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_Amount</name>
        <label>Add Amount</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varCreditTotal</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Loop_Posted.Amount__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Posted</targetReference>
        </connector>
    </assignments>
    <description>Keeps Billing Statement Credits Applied equal to the sum of its posted adjustments, so Balance reflects credits. Marks the statement Paid when credits clear it and no dispute is open. Fix for DEF-01 found in system testing. US-10, US-11.</description>
    <formulas>
        <name>fxNewStatus</name>
        <dataType>String</dataType>
        <expression>IF(AND(NOT({!Get_Statement.Dispute_Open__c}), {!Get_Statement.Amount_Due__c} - {!Get_Statement.Amount_Paid__c} - {!varCreditTotal} &lt;= 0), &quot;Paid&quot;, TEXT({!Get_Statement.Status__c}))</expression>
    </formulas>
    <interviewLabel>Apply Credits {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Adjustment - After Save - Apply Credits</label>
    <loops>
        <name>Loop_Posted</name>
        <label>Loop Posted</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Posted_Adjustments</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_Amount</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Get_Statement</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Posted_Adjustments</name>
        <label>Get Posted Adjustments</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Posted</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Billing_Statement__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Billing_Statement__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Posted</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Adjustment__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Amount__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Statement</name>
        <label>Get Statement</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Update_Statement</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Billing_Statement__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Billing_Statement__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Amount_Due__c</queriedFields>
        <queriedFields>Amount_Paid__c</queriedFields>
        <queriedFields>Status__c</queriedFields>
        <queriedFields>Dispute_Open__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_Statement</name>
        <label>Update Statement</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Statement.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Credits_Applied__c</field>
            <value>
                <elementReference>varCreditTotal</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <elementReference>fxNewStatus</elementReference>
            </value>
        </inputAssignments>
        <object>Billing_Statement__c</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Posted_Adjustments</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Billing_Statement__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>Adjustment__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varCreditTotal</name>
        <dataType>Currency</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
</Flow>
