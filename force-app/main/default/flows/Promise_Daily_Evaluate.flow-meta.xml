<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Add_Payment</name>
        <label>Add Payment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varReceived</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Each_Payment.Amount__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Each_Payment</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Grace_Ended</name>
        <label>Grace Period Ended?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Still in grace</defaultConnectorLabel>
        <rules>
            <name>Ended</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Grace_Ends__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <elementReference>fxToday</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Payments</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Kept_Or_Broken</name>
        <label>Kept or Broken?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Mark_Broken</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Broken</defaultConnectorLabel>
        <rules>
            <name>Kept</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varReceived</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>$Record.Promise_Amount__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Mark_Kept</targetReference>
            </connector>
            <label>Kept</label>
        </rules>
    </decisions>
    <description>Daily. For each Active promise whose grace period has ended, totals payments made on the related statement between the promise and the grace date. Kept if the total covers the promise, Broken otherwise. Records Amount Received and releases the account hold. The broken-promise count is maintained by Account - Daily - Broken Promise Count. US-04.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxPromiseLogged</name>
        <dataType>Date</dataType>
        <expression>DATEVALUE({!$Record.CreatedDate})</expression>
    </formulas>
    <formulas>
        <name>fxToday</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <interviewLabel>Promise to Pay - Daily - Evaluate {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Promise to Pay - Daily - Evaluate</label>
    <loops>
        <name>Each_Payment</name>
        <label>Each Payment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Payments</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Add_Payment</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Kept_Or_Broken</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Payments</name>
        <label>Get Payments in Window</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Each_Payment</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Billing_Statement__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Related_Statement__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Payment_Date__c</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>fxPromiseLogged</elementReference>
            </value>
        </filters>
        <filters>
            <field>Payment_Date__c</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <elementReference>$Record.Grace_Ends__c</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Payment__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Mark_Broken</name>
        <label>Mark Broken</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Release_Hold</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Amount_Received__c</field>
            <value>
                <elementReference>varReceived</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Broken</stringValue>
            </value>
        </inputAssignments>
        <object>Promise_to_Pay__c</object>
    </recordUpdates>
    <recordUpdates>
        <name>Mark_Kept</name>
        <label>Mark Kept</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Release_Hold</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Amount_Received__c</field>
            <value>
                <elementReference>varReceived</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Kept</stringValue>
            </value>
        </inputAssignments>
        <object>Promise_to_Pay__c</object>
    </recordUpdates>
    <recordUpdates>
        <name>Release_Hold</name>
        <label>Release Collection Hold</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Account__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Collection_Hold_Until__c</field>
            <value>
                <elementReference>varNoDate</elementReference>
            </value>
        </inputAssignments>
        <object>Account</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Grace_Ended</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Active</stringValue>
            </value>
        </filters>
        <object>Promise_to_Pay__c</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2026-10-10</startDate>
            <startTime>05:30:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varNoDate</name>
        <dataType>Date</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>varReceived</name>
        <dataType>Currency</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
    </variables>
</Flow>
