    <recordLookups>
        <name>Get_First_Statement</name>
        <label>Get First Statement</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>First_Statement_Unpaid</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Service_Contract__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Billing_Statement__c</object>
        <sortField>Due_Date__c</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Stamp_Welcome_Sent</name>
        <label>Stamp Welcome Sent On</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Welcome_Sent_On__c</field>
            <value>
                <elementReference>fxToday</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Can_Contact</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Activation_Date__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <object>ServiceContract</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
            <name>Before_First_Due</name>
            <connector>
                <targetReference>Get_First_Statement</targetReference>
            </connector>
            <label>7 Days Before First Due</label>
            <offsetNumber>-7</offsetNumber>
            <offsetUnit>Days</offsetUnit>
            <recordField>First_Due_Date__c</recordField>
            <timeSource>RecordField</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <textTemplates>
        <name>ttReminder</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Hi {!$Record.Account.Primary_Contact__r.FirstName},

A reminder that your first Lumenfield payment of {!$Record.Monthly_Payment__c} is due {!$Record.First_Due_Date__c}.

If you&apos;ve already paid or set up automatic payments, there&apos;s nothing else to do.

This is a message about your account, not a marketing message.</text>
    </textTemplates>
    <textTemplates>
        <name>ttWelcome</name>
        <isViewedAsPlainText>true</isViewedAsPlainText>
        <text>Welcome to Lumenfield Home Energy, {!$Record.Account.Primary_Contact__r.FirstName}.

Your solar system is active as of {!$Record.Activation_Date__c}. Your first payment of {!$Record.Monthly_Payment__c} is due {!$Record.First_Due_Date__c}.

To set up automatic payments, sign in to your Lumenfield account or call us at 1-800-555-0142.

This is a message about your account, not a marketing message.</text>
    </textTemplates>
</Flow>
