    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Can_Contact</name>
        <label>Can Contact?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Do Not Contact</defaultConnectorLabel>
        <rules>
            <name>Contact_Allowed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account.Do_Not_Contact__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Welcome_Needed</targetReference>
            </connector>
            <label>Contact allowed</label>
        </rules>
    </decisions>
    <decisions>
        <name>First_Statement_Unpaid</name>
        <label>First Statement Unpaid and Contact Allowed?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No reminder</defaultConnectorLabel>
        <rules>
            <name>Remind</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_First_Statement.Balance__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account.Do_Not_Contact__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account.Primary_Contact__r.Email</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Reminder</targetReference>
            </connector>
            <label>Send reminder</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_Email</name>
        <label>Primary Contact Has Email?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Follow_Up_Task</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No email</defaultConnectorLabel>
        <rules>
            <name>Email_Present</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account.Primary_Contact__r.Email</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Welcome</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Welcome_Needed</name>
        <label>Welcome Needed?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Already sent</defaultConnectorLabel>
        <rules>
            <name>Needed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Welcome_Sent_On__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Has_Email</targetReference>
            </connector>
            <label>Not yet sent</label>
        </rules>
    </decisions>
    <description>When a service contract is activated: emails the primary contact a welcome with payment setup details and stamps Welcome Sent On, once. Seven days before the first due date, emails a reminder unless the first statement is already paid. Servicing messages, so consent does not gate them (D-05); Do Not Contact stops both. A missing email creates a follow-up task instead of failing. Offset is fixed at 7 days because scheduled paths cannot read Pre_Due_Offset_Days. US-19, US-20, US-21.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxToday</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <interviewLabel>Service Contract - After Save - Welcome and First Payment Reminder {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Service Contract - After Save - Welcome and First Payment Reminder</label>
    <processMetadataValues>
