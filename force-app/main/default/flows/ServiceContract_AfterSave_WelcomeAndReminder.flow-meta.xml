        <actionType>emailSimple</actionType>
        <connector>
            <targetReference>Stamp_Welcome_Sent</targetReference>
        </connector>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>emailAddresses</name>
            <value>
                <elementReference>$Record.Account.Primary_Contact__r.Email</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>emailSubject</name>
            <value>
                <stringValue>Welcome to Lumenfield Home Energy</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
