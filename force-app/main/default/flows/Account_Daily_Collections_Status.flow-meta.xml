<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Default_Stamps_Needed</name>
        <label>Default Stamps Needed?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Review_Record_Type</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Already stamped</defaultConnectorLabel>
        <rules>
            <name>Needs_Threshold_Date</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Threshold_Crossed_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Default_Review_And_Date</targetReference>
            </connector>
            <label>Threshold date missing</label>
        </rules>
        <rules>
            <name>Needs_Status</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account_Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Default Review</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Default_Review</targetReference>
            </connector>
            <label>Status not Default Review</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Residential</name>
        <label>Is Residential?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Not residential</defaultConnectorLabel>
        <rules>
            <name>Residential</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Residential_Agreement</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Default_Threshold</targetReference>
            </connector>
            <label>Residential</label>
        </rules>
    </decisions>
    <decisions>
        <name>Review_Exists</name>
        <label>Open Review Exists?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Yes, leave it</defaultConnectorLabel>
        <rules>
            <name>No_Open_Review</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Open_Review</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Default_Review_Queue</targetReference>
            </connector>
            <label>No open review</label>
        </rules>
    </decisions>
    <decisions>
        <name>Status_Band</name>
        <label>Status Band</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Already correct</defaultConnectorLabel>
        <rules>
            <name>Default_Band</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Days_Past_Due__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>Get_Default_Threshold.Number_Value__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Default_Stamps_Needed</targetReference>
            </connector>
            <label>At or past default threshold</label>
        </rules>
        <rules>
            <name>Delinquent_Band</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Days_Past_Due__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account_Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Delinquent</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Delinquent</targetReference>
            </connector>
            <label>Past due, not marked Delinquent</label>
        </rules>
        <rules>
            <name>Current_Band</name>
            <conditionLogic>(1 OR 2) AND 3</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Days_Past_Due__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Days_Past_Due__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account_Status__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Current</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Current</targetReference>
            </connector>
            <label>Not past due, not marked Current</label>
        </rules>
    </decisions>
    <description>Daily. Sets Account Status on Residential Agreement accounts from Days Past Due: Current, Delinquent, or Default Review at the threshold in Policy_Setting__mdt (Default_Threshold_DPD). Stamps Threshold Crossed Date the first time an account reaches the threshold and opens a Default Review case owned by the Default Reviews queue if none is open. This is a security control as well as a convenience: the collections sharing rule depends on Account Status (D-08). Skips Closed and Hardship Review, which are set by people. US-05, US-15.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxReviewSubject</name>
        <dataType>String</dataType>
        <expression>&quot;Default review: &quot; &amp; {!$Record.Name}</expression>
    </formulas>
    <formulas>
        <name>fxThresholdDate</name>
        <dataType>Date</dataType>
        <expression>IF(ISBLANK({!$Record.Threshold_Crossed_Date__c}), TODAY(), {!$Record.Threshold_Crossed_Date__c})</expression>
    </formulas>
    <formulas>
        <name>fxToday</name>
        <dataType>Date</dataType>
        <expression>TODAY()</expression>
    </formulas>
    <interviewLabel>Account - Daily Collections Status {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Account - Daily Collections Status</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Create_Default_Review</name>
        <label>Create Default Review</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>AccountId</field>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ContactId</field>
            <value>
                <elementReference>$Record.Primary_Contact__c</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Description</field>
            <value>
                <stringValue>Opened automatically when the account reached the default threshold. Decide whether the account cures or defaults.</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>OwnerId</field>
            <value>
                <elementReference>Get_Default_Review_Queue.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Priority</field>
            <value>
                <stringValue>High</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>RecordTypeId</field>
            <value>
                <elementReference>Get_Review_Record_Type.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>New</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>fxReviewSubject</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Threshold_Crossed_Date__c</field>
            <value>
                <elementReference>fxThresholdDate</elementReference>
            </value>
        </inputAssignments>
        <object>Case</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Get_Default_Review_Queue</name>
        <label>Get Default Reviews Queue</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Create_Default_Review</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Default_Reviews</stringValue>
            </value>
        </filters>
        <filters>
            <field>Type</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Queue</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Group</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Default_Threshold</name>
        <label>Get Default Threshold</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Status_Band</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>DeveloperName</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Default_Threshold_DPD</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Policy_Setting__mdt</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Open_Review</name>
        <label>Get Open Review</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Review_Exists</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>AccountId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>RecordTypeId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Review_Record_Type.Id</elementReference>
            </value>
        </filters>
        <filters>
