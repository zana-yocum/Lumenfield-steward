<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Mark_Complete</name>
        <label>Mark Complete</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>Each_Open_Milestone.CompletionDate</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.CurrentDateTime</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>colMilestonesToComplete</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Each_Open_Milestone</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Each_Open_Milestone</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Any_To_Complete</name>
        <label>Any to Complete?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>None</defaultConnectorLabel>
        <rules>
            <name>Has_Milestones_To_Complete</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>colMilestonesToComplete</leftValueReference>
                <operator>IsEmpty</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Complete_Milestones</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Case_Closed</name>
        <label>Case Closed?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Acknowledge_Type</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Still open</defaultConnectorLabel>
        <rules>
            <name>Closed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.IsClosed</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Case_Team</targetReference>
            </connector>
            <label>Closed</label>
        </rules>
    </decisions>
    <decisions>
        <name>Has_Case_Team</name>
        <label>Has Case Team?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Get_Acknowledge_Type</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No team</defaultConnectorLabel>
        <rules>
            <name>Team_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Case_Team</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Remove_Case_Team</targetReference>
            </connector>
            <label>Team exists</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Billing_Dispute</name>
        <label>Is Billing Dispute?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Billing_Dispute</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordTypeId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Get_Dispute_Record_Type.Id</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Statement_Action</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Should_Complete</name>
        <label>Should Complete?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Each_Open_Milestone</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Not yet</defaultConnectorLabel>
        <rules>
            <name>Status_Reached_Milestone</name>
            <conditionLogic>(1 AND 2) OR (3 AND 4) OR (5 AND 6)</conditionLogic>
            <conditions>
                <leftValueReference>Each_Open_Milestone.MilestoneTypeId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Get_Acknowledge_Type.Id</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>fxStage</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Each_Open_Milestone.MilestoneTypeId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Get_Evidence_Type.Id</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>fxStage</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>2.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Each_Open_Milestone.MilestoneTypeId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Get_Resolve_Type.Id</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>fxStage</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>3.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Mark_Complete</targetReference>
            </connector>
            <label>Status reached this milestone</label>
        </rules>
    </decisions>
    <decisions>
        <name>Statement_Action</name>
        <label>Statement Action</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Case_Closed</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No statement</defaultConnectorLabel>
        <rules>
            <name>Flag_While_Open</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.IsClosed</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Disputed_Statement__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Flag_Statement_In_Dispute</targetReference>
            </connector>
            <label>Open dispute on a statement</label>
        </rules>
        <rules>
            <name>Clear_On_Close</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.IsClosed</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Disputed_Statement__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Disputed_Statement</targetReference>
            </connector>
            <label>Closed dispute on a statement</label>
        </rules>
    </decisions>
    <description>Runs when a Billing Dispute is created or its status changes. Flags the disputed statement (Dispute Open, In Dispute) while the case is open and restores its real status on close. Removes case team members on close so sales access ends with the dispute. Completes SLA milestones as the status advances, including any skipped earlier ones. US-07, US-08, US-09, US-18.</description>
    <environments>Default</environments>
    <formulas>
        <name>fxRestoredStatus</name>
        <dataType>String</dataType>
        <expression>IF({!Get_Disputed_Statement.Balance__c} &lt;= 0, &quot;Paid&quot;, IF({!Get_Disputed_Statement.Due_Date__c} &lt; TODAY(), &quot;Past Due&quot;, &quot;Open&quot;))</expression>
    </formulas>
    <formulas>
        <name>fxStage</name>
        <dataType>Number</dataType>
        <expression>CASE(TEXT({!$Record.Status}), &quot;Acknowledged&quot;, 1, &quot;Awaiting Evidence&quot;, 2, &quot;Under Review&quot;, 2, &quot;Pending Credit Approval&quot;, 2, &quot;Resolved&quot;, 3, &quot;Closed&quot;, 3, 0)</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Case - Dispute Lifecycle {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Case - After Save - Dispute Lifecycle</label>
    <loops>
        <name>Each_Open_Milestone</name>
        <label>Each Open Milestone</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Open_Milestones</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Should_Complete</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Any_To_Complete</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordDeletes>
        <name>Remove_Case_Team</name>
        <label>Remove Case Team</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Acknowledge_Type</targetReference>
        </connector>
        <inputReference>Get_Case_Team</inputReference>
    </recordDeletes>
    <recordLookups>
