<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Days_Past_Due__c</fullName>
    <description>Days since the oldest past-due statement came due. Zero when the account is current.</description>
    <externalId>false</externalId>
    <formula>IF(ISBLANK(Oldest_Past_Due_Date__c), 0, TODAY() - Oldest_Past_Due_Date__c)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Days Past Due</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
