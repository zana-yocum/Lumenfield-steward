<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Review_Opened_On_Time__c</fullName>
    <formula>AND(
  NOT(ISBLANK(Threshold_Crossed_Date__c)),
  DATEVALUE(CreatedDate) - Threshold_Crossed_Date__c &lt;= $CustomMetadata.Policy_Setting__mdt.Default_Review_Window_Days.Number_Value__c
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Review Opened On Time</label>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
