<?xml version="1.0" encoding="UTF-8"?>
<BusinessProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Default_Review_Process</fullName>
    <description>Status path for default reviews opened when an account crosses the 90+ days past due threshold. Ends Cured (account brought current) or Default Confirmed. Closed is for reviews opened in error. US-15.</description>
    <isActive>true</isActive>
    <values>
        <fullName>Closed</fullName>
        <default>false</default>
    </values>
    <values>
        <fullName>Cured</fullName>
        <default>false</default>
    </values>
    <values>
        <fullName>Default Confirmed</fullName>
        <default>false</default>
    </values>
    <values>
        <fullName>New</fullName>
        <default>true</default>
    </values>
    <values>
        <fullName>Under Review</fullName>
        <default>false</default>
    </values>
</BusinessProcess>
