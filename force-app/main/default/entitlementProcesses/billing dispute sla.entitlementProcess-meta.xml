<?xml version="1.0" encoding="UTF-8"?>
<EntitlementProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <SObjectType>Case</SObjectType>
    <active>true</active>
    <businessHours>Lumenfield Support Hours</businessHours>
    <description>Three-milestone SLA for billing disputes: acknowledge in 1 business day, request evidence in 3, resolve in 10. US-09.</description>
    <entryStartDateField>Case.CreatedDate</entryStartDateField>
    <exitCriteriaFilterItems>
        <field>Case.IsClosed</field>
        <operation>equals</operation>
        <value>true</value>
    </exitCriteriaFilterItems>
    <milestones>
        <isDisplayedOnLinkedEntity>false</isDisplayedOnLinkedEntity>
        <milestoneName>Acknowledge Dispute</milestoneName>
        <minutesToComplete>600</minutesToComplete>
        <timeTriggers>
            <actions>
                <name>Dispute_Milestone_Violation</name>
                <type>Alert</type>
            </actions>
            <timeLength>0</timeLength>
            <workflowTimeTriggerUnit>Minutes</workflowTimeTriggerUnit>
        </timeTriggers>
        <timeTriggers>
            <actions>
                <name>Dispute_Milestone_Warning</name>
                <type>Alert</type>
            </actions>
            <timeLength>-150</timeLength>
            <workflowTimeTriggerUnit>Minutes</workflowTimeTriggerUnit>
        </timeTriggers>
        <useCriteriaStartTime>false</useCriteriaStartTime>
    </milestones>
    <milestones>
        <isDisplayedOnLinkedEntity>false</isDisplayedOnLinkedEntity>
        <milestoneName>Request Evidence</milestoneName>
        <minutesToComplete>1800</minutesToComplete>
        <timeTriggers>
            <actions>
                <name>Dispute_Milestone_Warning</name>
                <type>Alert</type>
            </actions>
            <timeLength>-450</timeLength>
            <workflowTimeTriggerUnit>Minutes</workflowTimeTriggerUnit>
        </timeTriggers>
        <timeTriggers>
            <actions>
                <name>Dispute_Milestone_Violation</name>
                <type>Alert</type>
            </actions>
            <timeLength>0</timeLength>
            <workflowTimeTriggerUnit>Minutes</workflowTimeTriggerUnit>
        </timeTriggers>
        <useCriteriaStartTime>false</useCriteriaStartTime>
    </milestones>
    <milestones>
        <isDisplayedOnLinkedEntity>false</isDisplayedOnLinkedEntity>
        <milestoneName>Resolve Dispute</milestoneName>
        <minutesToComplete>6000</minutesToComplete>
        <timeTriggers>
            <actions>
                <name>Dispute_Milestone_Violation</name>
                <type>Alert</type>
            </actions>
            <timeLength>0</timeLength>
            <workflowTimeTriggerUnit>Minutes</workflowTimeTriggerUnit>
        </timeTriggers>
        <timeTriggers>
            <actions>
                <name>Dispute_Milestone_Warning</name>
                <type>Alert</type>
            </actions>
            <timeLength>-1500</timeLength>
            <workflowTimeTriggerUnit>Minutes</workflowTimeTriggerUnit>
        </timeTriggers>
        <useCriteriaStartTime>false</useCriteriaStartTime>
    </milestones>
</EntitlementProcess>
